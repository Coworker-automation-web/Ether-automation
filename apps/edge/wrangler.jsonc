{
  "name": "ether-edge",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Secrets (GOOGLE_CLIENT_SECRET, ENCRYPTION_KEY, provider keys) are set with
  // `wrangler secret put` and must never appear in this file.
  "vars": { "APP_ORIGIN": "http://localhost:4321" },
  "d1_databases": [
    { "binding": "DB", "database_name": "ether", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "src/db/migrations" }
  ],
  // No R2: snapshot and upload bytes live in D1 child tables (see src/db/schema.ts).
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE_ROOM", "class_name": "WorkspaceRoom" },
      { "name": "QUOTA_GUARD", "class_name": "QuotaGuard" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceRoom", "QuotaGuard"] }]
}
