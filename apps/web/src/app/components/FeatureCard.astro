---
import { Icon, type IconName } from './Icon';
import styles from './FeatureCard.module.css';

export interface Props {
  icon: IconName;
  titleLines: string[];
  description: string;
}

const { icon, titleLines, description } = Astro.props;
---

<div class={styles.card}>
  <div class={styles.iconBox}>
    <Icon name={icon} />
  </div>
  <h3 class={styles.title}>
    {titleLines.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}
  </h3>
  <p class={styles.desc}>{description}</p>
</div>
