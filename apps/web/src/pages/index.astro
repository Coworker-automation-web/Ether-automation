---
import Head from './_Head.astro';
import { navItems } from './_nav';
import shell from '../app/components/AppShell.module.css';
import landing from '../app/components/LandingContent.module.css';
import { Sidebar } from '../app/components/Sidebar';
import { Topbar } from '../app/components/Topbar';
import Hero from '../app/components/Hero.astro';
import CreateWorkspaceCard from '../app/components/CreateWorkspaceCard.astro';
import FeatureGrid from '../app/components/FeatureGrid.astro';
import TeamsSection from '../app/components/TeamsSection.astro';

const features = [
  { icon: 'zap', titleLines: ['Real-time', 'Collaboration'], description: 'Work together, instantly.' },
  { icon: 'box', titleLines: ['AI-Powered', 'Productivity'], description: 'Build smarter, faster.' },
  { icon: 'shield-check', titleLines: ['Secure & Private'], description: 'Your data, your control.' },
  { icon: 'grid', titleLines: ['Flexible Workspaces'], description: 'Organise your work your way.' },
] as const;
---

<html lang="en">
  <head>
    <Head
      title="Ether – Elevate the way you work, Together."
      description="Plan, create, and collaborate — all in one powerful workspace for your team and ideas."
    />
  </head>
  <body>
    <div class={shell.container}>
      <Sidebar
        homeHref="/"
        items={navItems('/')}
        footer={{ titleLines: ['Build. Collaborate.', 'Grow together.'], markAbove: true }}
      />

      <div class={shell.main}>
        <Topbar initials="V" />

        <main class={landing.content}>
          <Hero
            badgeLabel="A collaborative workspace"
            headingLines={['Elevate the way', 'you work,']}
            headingEmphasis="Together."
            description="Plan, create, and collaborate — all in one powerful workspace for your team and ideas."
            primaryLabel="Get Started"
            primaryHref="/login"
            secondaryLabel="Learn More"
            secondaryHref="#create-workspace"
            avatarInitials={['A', 'M', 'S']}
          />

          <CreateWorkspaceCard
            id="create-workspace"
            tagLabel="Start with Ether"
            titleLines={['Create your', 'workspace']}
            description="Turn ideas into action. Start a new workspace and bring your team together."
            ctaLabel="New Workspace"
            ctaHref="/login"
          />

          <FeatureGrid id="features" items={features.map((f) => ({ ...f, titleLines: [...f.titleLines] }))} />

          <TeamsSection
            eyebrow="Built for teams"
            titleLines={['One space.', 'Infinite possibilities.']}
            description="Bring your team, ideas and goals together on Ether."
            ctaLabel="Explore Features"
            ctaHref="#features"
          />
        </main>
      </div>
    </div>

    <script src="./_landing-scroll.ts"></script>
  </body>
</html>
